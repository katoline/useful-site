# ビルド時に読む設定（Vite の VITE_ 接頭辞の環境変数）。.env にコピーして値を入れる。
# .env / .env.* は git に入れない（このファイルだけ入れる）。

# 公開するオリジン（https://ホスト名。末尾スラッシュ・パスなし）。
# canonical・hreflang・og:url・sitemap.xml の絶対 URL に使う。
# 未設定なら既定値（app/platform/config/index.ts の DEFAULT_SITE_ORIGIN。暫定ドメイン）になる。
# ドメインを変えるときは app/platform/config/index.ts の DEFAULT_SITE_ORIGIN と wrangler.jsonc の routes を変える。
# VITE_SITE_ORIGIN は一時的な上書き用（例 VITE_SITE_ORIGIN=https://<公開するドメイン>）。
# 仮の値（example ドメイン等）・https 以外・パス付きなら、本番ビルドで警告が出て、
# `pnpm run deploy` はビルドの前に止まる。wrangler.jsonc の routes のホストと一致しないときも止まる。
VITE_SITE_ORIGIN=

# Google AdSense のクライアント ID（例 ca-pub-0000000000000000）。
# 未設定なら広告枠は dev で破線のプレースホルダー、本番で非表示。ads.txt もこの値から作る。
# 設定すると、ハイドレーション後に表示が落ち着いてから adsbygoogle.js を 1 ページ 1 回だけ読む。
VITE_ADSENSE_CLIENT=

# 広告ユニット ID（data-ad-slot。数字のみ。それ以外の値は未設定と同じ扱い）。
# 形式ごとの既定値で、<AdSlot format="..."> が slot を省略したときに使う。
# クライアント ID と ID の両方が揃った形式の枠だけが広告を要求する（揃わなければ dev はプレースホルダー、本番は非表示）。
VITE_ADSENSE_SLOT_BANNER=
VITE_ADSENSE_SLOT_RESPONSIVE=
VITE_ADSENSE_SLOT_IN_ARTICLE=
VITE_ADSENSE_SLOT_SIDEBAR=

# Cloudflare Web Analytics のトークン。設定したときだけビーコンを入れる。
VITE_CF_ANALYTICS_TOKEN=
