{
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["app/apps/*/sw/**/*", "app/platform/config/**/*"]
}
