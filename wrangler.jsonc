{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "useful-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // サイト全体を担当する。公開オリジンは platform/config とそろえる。
  "routes": [{ "pattern": "t0n03k1.com/*", "zone_name": "t0n03k1.com" }],
  // 独自ドメインでの公開を確認したので workers.dev は無効にする。routes があると wrangler は
  // 既定で false にするが、明示しておく（ダッシュボード側の設定も次のデプロイでそろう）
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    // API だけ Worker を先に通し、それ以外は静的アセット（プリレンダリング済み HTML 等）を返す
    "run_worker_first": ["/*/api/*"],
    // /about → /about/ に寄せ、about/index.html を返す（末尾スラッシュ付きに統一）
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // fetch-image の回数制限（IP あたり 1 分 20 回）。namespace_id はアカウント内で一意な整数
  "ratelimits": [
    {
      "name": "FETCH_IMAGE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    // 回線速度テストの測定の開始（/speed-test/api/info）の回数制限（IP あたり 1 分 10 回 ＝ 測定 10 回）
    {
      "name": "SPEED_TEST_START_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    // 回線速度テストの転送の回数制限（IP あたり 1 分 1200 回。速い回線の 1 回の測定で 150〜250 回使う）
    {
      "name": "SPEED_TEST_TRANSFER_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 1200, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
