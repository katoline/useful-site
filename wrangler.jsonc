{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-adjust",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    // API だけ Worker を先に通し、それ以外は静的アセット（プリレンダリング済み HTML 等）を返す
    "run_worker_first": ["/image-adjust/api/*"],
    // /about → /about/ に寄せ、about/index.html を返す（末尾スラッシュ付きに統一）
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // fetch-image の回数制限（IP あたり 1 分 20 回）。namespace_id はアカウント内で一意な整数
  "ratelimits": [
    {
      "name": "FETCH_IMAGE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
