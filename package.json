{
  "name": "useful-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "react-router build && node scripts/postbuild.ts",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.sw.json",
    "lint": "biome check . && node scripts/check-boundaries.ts",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:fix": "biome check --write .",
    "check:apps": "node scripts/check-app-removal.ts",
    "deploy": "node scripts/check-deploy-env.ts && pnpm build && wrangler deploy"
  },
